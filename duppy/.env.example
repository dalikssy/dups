# Admin Hub (dupscaled.com/adminhub). Copy to .env.local for local development
# and set the same variables in the Vercel project.

# Login. Generate with: npx auth secret
AUTH_SECRET=
# Google OAuth client (Internal). Authorised redirect URIs:
#   <origin>/api/auth/callback/google
#   <origin>/api/adminhub/gmail/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Always-allowed admins, comma separated. Everyone else is added in Settings.
ADMIN_EMAILS=

# Neon Postgres connection string
DATABASE_URL=

# Claude API (lead finder and drafts)
ANTHROPIC_API_KEY=

# Mailbox the drafts are created in
GMAIL_SENDER=info@dupscaled.com

# Any long random string. Protects the daily sync cron.
CRON_SECRET=
